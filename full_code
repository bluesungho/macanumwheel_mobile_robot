    vel_x_cf = 0.0f;
    vel_y_cf = 0.0f;
    vimu_x = 0.0f;   // 선택(드리프트 억제)
    vimu_y = 0.0f;
  }
}


void X_Y_aixs() 
{
  Vy_enc = r*0.25f*(Vel_omega1 + Vel_omega2 + Vel_omega3 + Vel_omega4);
  Vx_enc = r*0.25f*(-Vel_omega1 + Vel_omega2 + Vel_omega3 - Vel_omega4);
  Ww_enc = r*0.25f/(a+b) * (-Vel_omega1 + Vel_omega2 - Vel_omega3 + Vel_omega4);
  
