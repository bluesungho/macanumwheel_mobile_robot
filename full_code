void jetson_orin_tx(void)
{
  // 1. 타임스탬프 누적
  Timestamp += 0.05f;
  
  jetsonPacket.header = 0xAA;
  jetsonPacket.pos_x = pos_x;
  jetsonPacket.pos_y = pos_y;
  jetsonPacket.Sx_ref = Sx_ref; // 변수명 확인 필요 (Sx_ref)
  jetsonPacket.Sy_ref = Sy_ref;
  jetsonPacket.yaw = yaw;
  jetsonPacket.yaw_ref = yaw_ref;
  jetsonPacket.Vx_target = Vx_target;
  jetsonPacket.Vy_target = Vy_target;
  jetsonPacket.timestamp = Timestamp;
  
  // 3. 체크섬 계산 (선택사항이지만 데이터 무결성을 위해 추천)
  uint8_t csum = 0;
  uint8_t *ptr = (uint8_t*)&jetsonPacket;
  for(int i = 0; i < sizeof(JetsonTxPacket) - 1; i++) {
    csum += ptr[i];
  }
  jetsonPacket.checksum = csum;
  
  // 4. 안전하게 DMA로 송신 (구조체의 주소값을 바로 넘김)
  // 이전 송신이 완료되었는지 확인 후 송신하는 것이 안전합니다.
  if(huart5.gState == HAL_UART_STATE_READY)
  {
    HAL_UART_Transmit_DMA(&huart5, (uint8_t*)&jetsonPacket, sizeof(JetsonTxPacket));
  }
}


void jetson_orin_rx(void)
{
  // 1. ORE(Overrun Error) 및 에러 플래그 해제 (수신 멈춤 방지)
  if (__HAL_UART_GET_FLAG(&huart5, UART_FLAG_ORE))
  {
    __HAL_UART_CLEAR_OREFLAG(&huart5);
  }
  
  // 2. DMA 수신 버퍼 갱신 시작 (Circular 모드인 경우 HAL_BUSY를 리턴하므로 안전함)
  HAL_UART_Receive_DMA(&huart5, jetson_rx_buffer, JETSON_RX_BUF_SIZE);
  
  // 3. 버퍼 전체를 돌며 스타트 바이트 0xFD가 매칭되는 지점 탐색 및 검증
  for(int i = 0; i < JETSON_RX_BUF_SIZE; i++)
  {
    if(jetson_rx_buffer[i] == 0xFD)
    {
      // 19바이트 크기의 임시 버퍼에 링 버퍼 형식으로 복사 (끝부분 경계 고려)
      uint8_t temp_buf[19];
      for(int j = 0; j < 19; j++)
      {
        temp_buf[j] = jetson_rx_buffer[(i + j) % JETSON_RX_BUF_SIZE];
      }
      
      // 4. 엔드 바이트가 0xFE인지 검증
      if(temp_buf[18] == 0xFE)
      {
        // 5. 체크섬 계산 (0~16번 인덱스 합산)
        uint8_t calc_checksum = 0;
        for (int k = 0; k < 17; k++)
        {
          calc_checksum += temp_buf[k];
        }
        
        // 6. 체크섬이 완벽히 일치할 때만 데이터 수용
        if (calc_checksum == temp_buf[17])
        {
          memcpy(&logic_packet, temp_buf, sizeof(JetsonPacket));
          
          Manipulator_Target_X = logic_packet.corrected_x;
          Manipulator_Target_Y = logic_packet.corrected_y;
          Manipulator_Camera_X = logic_packet.camera_x;
          Manipulator_Camera_Y = logic_packet.camera_y;
          
          rx_ready_flag = 1;
          break; // 올바른 패킷을 찾았으므로 더 이상의 루프는 돌지 않고 탈출
        }
      }
    }
  }
}

