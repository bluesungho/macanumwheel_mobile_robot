static inline void SoftStop_All(void)
{
  // trajectory command만 0으로 (DOB는 계속 돌게)
  Vx_traj_b = 0.0f;
  Vy_traj_b = 0.0f;
  W_b       = 0.0f;
  
  Vx_target = 0.0f;
  Vy_target = 0.0f;
}


static inline void ForceStop_All(void)
{
  Vx_b = 0.0f; Vy_b = 0.0f; W_b = 0.0f;
  Vx_traj_b = 0.0f; Vy_traj_b = 0.0f;
  
  // PI 적분항/출력 리셋
  Vel_Error_Sum1 = Vel_Error_Sum2 = Vel_Error_Sum3 = Vel_Error_Sum4 = 0.0f;
  Vel_Control1   = Vel_Control2   = Vel_Control3   = Vel_Control4   = 0.0f;
  
  Current_Error_Sum1 = Current_Error_Sum2 = Current_Error_Sum3 = Current_Error_Sum4 = 0.0f;
  Current_Control1   = Current_Control2   = Current_Control3   = Current_Control4   = 0.0f;
  
  // PWM 0
  Motor_CCR1 = 0; Motor_CCR2 = 0; Motor_CCR3 = 0; Motor_CCR4 = 0;
  
  // 목표값 0
  target1 = 0.0f; target2 = 0.0f; target3 = 0.0f; target4 = 0.0f;
}

void Trajectory_squre_function(void)
{
  static int trajectory_state = 0;
  
  static uint8_t corner_hold = 0;
  static int hold_cnt = 0;
  
  // 코너 홀드 끝나고 하드리셋(ForceStop) 할지 여부
  // 사각형 계속 돌 거면 0 유지, “한 변만 테스트”하고 끝낼 거면 1로 세팅
  static uint8_t do_force_after_hold = 0;
  
  // ====== 튜닝 파라미터 ======
  const float L_traj = 1.5f;   // 사각형 한 변 길이 [m]
  const float dt_ref = 0.05;
  // float v_traj 는 전역에 이미 있음 (너 코드: float v_traj = 5.0;)
  
  // ====== “한 축만 직진 테스트” 하고 싶으면 여기만 바꾸면 됨 ======
  // 1) 아래 #define을 1로 바꾸면 Y+ 방향으로만 가는 모드
  // 2) 아래 #define을 1로 바꾸면 X+ 방향으로만 가는 모드
  // (둘 다 1이면 Y가 우선 적용되게 해놨음)
#define TEST_ONLY_Y_POS 0  // <-- Y축(+Y)만 가고 싶으면 1로
#define TEST_ONLY_X_POS 0  // <-- X축(+X)만 가고 싶으면 1로
  
  if (Brk == 1)
  {
    ForceStop_All();
    vel_x_model = 0.0f;
    vel_y_model = 0.0f;
    trajectory_state = 0;
    corner_hold = 0;
    hold_cnt = 0;
    do_force_after_hold = 0;
    s_ref = 0.0f;
    return;
  }
  
  // ====== 코너 홀드 구간 ======
  if (corner_hold)
  {
    SoftStop_All();  // ★ 여기서는 DOB 상태 유지하면서 “명령만 0”
    
    if (++hold_cnt >= CORNER_HOLD_N)
    {
      corner_hold = 0;
      hold_cnt = 0;
      s_ref = 0.0f;
      
      if (do_force_after_hold)
      {
        ForceStop_All();
        Brk = 1;     // “한 변만 테스트 후 종료” 용도
        do_force_after_hold = 0;
        return;
      }
    }
    return;
  }
  
  // ====== 목표 world 속도 ======
  
  // ====== 한 축만 테스트 모드 ======
#if (TEST_ONLY_Y_POS == 1)
  {
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      do_force_after_hold = 1; // 한 변만 하고 끝낼거면 1
      SoftStop_All();
      return;
    }
    v = v_traj;
    vx_world = 0.0f;
    vy_world = +v;
    
    s_ref += fabsf(v) * dt_ref / 14.0;
  }
#elif (TEST_ONLY_X_POS == 1)
  {
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      do_force_after_hold = 1; // 한 변만 하고 끝낼거면 1
      SoftStop_All();
      return;
    }
    v = v_traj;
    vx_world = +v;
    vy_world = 0.0f;
    
    s_ref += fabsf(v) * dt_ref / 14.0;
  }
  
#else
  // ====== 사각형 경로 ======
  // state 0: (0,0) -> (0,L) : +Y
  // state 1: (0,L) -> (L,L) : +X
  // state 2: (L,L) -> (L,0) : -Y
  // state 3: (L,0) -> (0,0) : -X
  switch (trajectory_state)
  {
  case 0:
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 1;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = 0.0f;
    vy_world = +v;
    s_ref += fabsf(v) * dt_ref / 14.0;
    break;
    
  case 1:
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 2;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = +v;
    vy_world = 0.0f;
    s_ref += fabsf(v) * dt_ref / 14.0;
    break;
    
  case 2:
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 3;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = 0.0f;
    vy_world = -v;
    s_ref += fabsf(v) * dt_ref / 14.0;
    break;
    
  case 3:
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      do_force_after_hold = 1;
      trajectory_state = 4;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = -v;
    vy_world = 0.0f;
    s_ref += fabsf(v) * dt_ref / 14.0;
    break;
    
  case 4:
    {
      float dx_comp = Manipulator_Target_X;
      float dy_comp = Manipulator_Target_Y;
      float comp_dist = sqrtf(dx_comp * dx_comp + dy_comp * dy_comp);
      
      // 보정 이동 완료 확인
      if (comp_dist <= 0.001f || s_ref >= comp_dist)
      {
        corner_hold = 1;
        hold_cnt = 0;
        do_force_after_hold = 1; // 보정 주행까지 완벽히 끝났으므로 최종 정지 (Brk = 1)
        trajectory_state = 0;
        SoftStop_All();
        return;
      }
      
      // 보정 오프셋 방향 단위 벡터 계산 및 world 속도 생성
      v = v_traj;
      vx_world = v * (dx_comp / comp_dist);
      vy_world = v * (dy_comp / comp_dist);
      s_ref += fabsf(v) * dt_ref / 14.0f;
    }
    break;
    
  default:
    trajectory_state = 0;
    s_ref = 0.0f;
    break;
  }
#endif
  
  // ====== world -> body 변환 (yaw 기준) ======
  W_b = 0.0f;
  float current_yaw_rad = yaw * (pi / 180.0f);
  
  Vx_traj_b =  vx_world * cosf(current_yaw_rad) + vy_world * sinf(current_yaw_rad);
  Vy_traj_b = -vx_world * sinf(current_yaw_rad) + vy_world * cosf(current_yaw_rad);
}

void Trajectory_triangle_function(void)
{
  static int trajectory_state = 0;
  
  static uint8_t corner_hold = 0;
  static int hold_cnt = 0;
  
  static uint8_t do_force_after_hold = 0;
  
  // ====== 튜닝 파라미터 ======
  const float L_traj = 1.5f;      // 정삼각형 한 변 [m]
  const float dt_ref = 0.05f;   
  
  if (Brk == 1)
  {
    ForceStop_All();
    vel_x_model = 0.0f;
    vel_y_model = 0.0f;
    trajectory_state = 0;
    corner_hold = 0;
    hold_cnt = 0;
    do_force_after_hold = 0;
    s_ref = 0.0f;
    return;
  }
  
  // ====== 코너 홀드 구간 ======
  if (corner_hold)
  {
    SoftStop_All();
    
    if (++hold_cnt >= CORNER_HOLD_N)
    {
      corner_hold = 0;
      hold_cnt = 0;
      s_ref = 0.0f;   // 다음 변 시작 전에 ref 진행거리 초기화
      
      if (do_force_after_hold)
      {
        ForceStop_All();
        Brk = 1;
        do_force_after_hold = 0;
        return;
      }
    }
    return;
  }
  
  // ====== 정삼각형 경로 ======
  // state 0: (0,0) -> (0,L)                  : +Y
  // state 1: (0,L) -> (sqrt(3)/2*L, L/2)     : 우하향
  // state 2: (sqrt(3)/2*L, L/2) -> (0,0)     : 좌하향
  
  switch (trajectory_state)
  {
  case 0:
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 1;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = 0.0f;
    vy_world = +v;
    
    s_ref += fabsf(v) * dt_ref / 14.0;
    break;
    
  case 1:
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 2;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = +0.8660254f * v;   // cos(30°)
    vy_world = -0.5f * v;         // -sin(30°)
    
    s_ref += fabsf(v) * dt_ref / 14.0;
    break;
    
  case 2:
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      do_force_after_hold = 1;
      trajectory_state = 0;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = -0.8660254f * v;
    vy_world = -0.5f * v;
    
    s_ref += fabsf(v) * dt_ref / 14.0;
    break;
    
  default:
    trajectory_state = 0;
    s_ref = 0.0f;
    break;
  }
  
  // ====== world -> body 변환 (yaw 기준) ======
  W_b = 0.0f;
  float current_yaw_rad = yaw * (pi / 180.0f);
  
  Vx_traj_b =  vx_world * cosf(current_yaw_rad) + vy_world * sinf(current_yaw_rad);
  Vy_traj_b = -vx_world * sinf(current_yaw_rad) + vy_world * cosf(current_yaw_rad);
}

void Trajectory_eight_circle_function(void)
{
  static int circle_state = 0;     // 0: 아래 원(CCW), 1: 위 원(CW)
  static float theta = -pi/2.0f;   // 시작점: 아래 원의 맨 아래
  static uint8_t done_once = 0;
  
  // ====== 파라미터 ======
  const float R = 0.5f;           // 원 반지름 [m]  -> 지름 1.0 m
  const float dt_ref = 0.05f;     
  
  // 아래 원 중심: (0, -R)
  // 위   원 중심: (0, +R)
  
  if (Brk == 1)
  {
    ForceStop_All();
    vel_x_model = 0.0f;
    vel_y_model = 0.0f;
    
    circle_state = 0;
    theta = -pi/2.0f;
    done_once = 0;
    return;
  }
  
  if (done_once)
  {
    SoftStop_All();
    return;
  }
  
  // 선속도 v_traj [m/s]를 기준으로 각속도 계산
  // v = R * omega  -> omega = v/R
  float omega = 0.0f;
  if (R > 1e-6f)
  {
    omega = v_traj / R;
  }
  
  // ====== 원 궤적 ======
  if (circle_state == 0)
  {
    // ==============================
    // 아래 원: CCW
    // 중심 (0, -R)
    // x = R cos(theta)
    // y = -R + R sin(theta)
    // ==============================
    
    vx_world = -R * sinf(theta) * omega;
    vy_world =  R * cosf(theta) * omega;
    
    theta += omega * dt_ref / 14.0;
    
    // 아래 원 한 바퀴 끝 -> 위 원으로 전환
    if (theta >= 3.0f*pi/2.0f)
    {
      theta = pi/2.0f;   // 위 원 접점 시작각
      circle_state = 1;
    }
  }
  else
  {
    // ==============================
    // 위 원: CW
    // 중심 (0, +R)
    // x = R cos(theta)
    // y = +R + R sin(theta)
    // CW 이므로 theta 감소
    // ==============================
    
    vx_world = +R * sinf(theta) * omega;
    vy_world = -R * cosf(theta) * omega;
    
    theta -= omega * dt_ref / 14.0;
    
    // 위 원 한 바퀴 끝 -> 아래 원으로 전환
    if (theta <= -3.0f*pi/2.0f)
    {
      done_once = 1;
      SoftStop_All();
      Brk = 1;     // 완전히 끝내고 싶으면 유지
      return;
    }
  }
  
  // ====== world -> body 변환 ======
  W_b = 0.0f;
  float current_yaw_rad = yaw * (pi / 180.0f);
  
  Vx_traj_b =  vx_world * cosf(current_yaw_rad) + vy_world * sinf(current_yaw_rad);
  Vy_traj_b = -vx_world * sinf(current_yaw_rad) + vy_world * cosf(current_yaw_rad);
}


void Trajectory_parallelogram_function(void)
{
  static int trajectory_state = 0;
  
  static uint8_t corner_hold = 0;
  static int hold_cnt = 0;
  
  static uint8_t do_force_after_hold = 0;
  
  // ====== 튜닝 파라미터 ======
  const float L_traj = 1.5f;      // 평행사변형 한 변의 길이 [m]
  const float dt_ref = 0.05f;   
  
  if (Brk == 1)
  {
    ForceStop_All();
    vel_x_model = 0.0f;
    vel_y_model = 0.0f;
    trajectory_state = 0;
    corner_hold = 0;
    hold_cnt = 0;
    do_force_after_hold = 0;
    s_ref = 0.0f;
    return;
  }
  
  // ====== 코너 홀드 구간 ======
  if (corner_hold)
  {
    SoftStop_All();
    
    if (++hold_cnt >= CORNER_HOLD_N)
    {
      corner_hold = 0;
      hold_cnt = 0;
      s_ref = 0.0f;   // 다음 변 시작 전에 ref 진행거리 초기화
      
      if (do_force_after_hold)
      {
        ForceStop_All();
        Brk = 1;
        do_force_after_hold = 0;
        return;
      }
    }
    return;
  }
  
  // ====== 평행사변형 경로 (모든 변 1.5m, 내각 60°/120°) ======
  // state 0: 우상향 (60° 방향 이동)
  // state 1: 우측 수평 (+X 방향 이동)
  // state 2: 좌하향 (240° 방향 이동) -> state 0과 평행
  // state 3: 좌측 수평 (-X 방향 이동) -> state 1과 평행 및 원점 복귀
  
  switch (trajectory_state)
  {
  case 0: // 우상향 변 (60° 방향)
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 1;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = +0.5f * v;         // cos(60°)
    vy_world = +0.8660254f * v;   // sin(60°)
    
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  case 1: // 상단 수평 변 (+X 방향)
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 2;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = +v;
    vy_world = 0.0f;
    
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  case 2: // 좌하향 변 (240° 방향, state 0과 평행)
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 3;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = -0.5f * v;         // -cos(60°)
    vy_world = -0.8660254f * v;   // -sin(60°)
    
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;

  case 3: // 하단 수평 변 (-X 방향, state 1과 평행 - 복귀)
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      do_force_after_hold = 1;    // 1주기 완료 후 정지
      trajectory_state = 0;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = -v;
    vy_world = 0.0f;
    
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  default:
    trajectory_state = 0;
    s_ref = 0.0f;
    break;
  }
  
  // ====== world -> body 변환 (yaw 기준) ======
  W_b = 0.0f;
  float current_yaw_rad = yaw * (pi / 180.0f);
  
  Vx_traj_b =  vx_world * cosf(current_yaw_rad) + vy_world * sinf(current_yaw_rad);
  Vy_traj_b = -vx_world * sinf(current_yaw_rad) + vy_world * cosf(current_yaw_rad);
}

void Trajectory_zigzag_function(void)
{
  static int trajectory_state = 0;
  
  static uint8_t corner_hold = 0;
  static int hold_cnt = 0;
  
  static uint8_t do_force_after_hold = 0;
  
  // ====== 튜닝 파라미터 ======
  const float L_traj = 1.0f;      // 각 변의 길이 [m]
  const float dt_ref = 0.05f;   
  
  if (Brk == 1)
  {
    ForceStop_All();
    vel_x_model = 0.0f;
    vel_y_model = 0.0f;
    trajectory_state = 0;
    corner_hold = 0;
    hold_cnt = 0;
    do_force_after_hold = 0;
    s_ref = 0.0f;
    return;
  }
  
  // ====== 코너 홀드 구간 ======
  if (corner_hold)
  {
    SoftStop_All();
    
    if (++hold_cnt >= CORNER_HOLD_N)
    {
      corner_hold = 0;
      hold_cnt = 0;
      s_ref = 0.0f;   // 다음 변 시작 전에 ref 진행거리 초기화
      
      if (do_force_after_hold)
      {
        ForceStop_All();
        Brk = 1;
        do_force_after_hold = 0;
        return;
      }
    }
    return;
  }
  
  // ====== 지그재그 경로 (좌표계: +X = 왼쪽, +Y = 위쪽) ======
  // state 0: 1번째 변 -> 코드상 (+X, +Y) 설정  => 실제 동작: 왼쪽 위(좌상향) 출발
  // state 1: 2번째 변 -> 코드상 (-X, +Y) 설정  => 실제 동작: 오른쪽 위(우상향)
  // state 2: 3번째 변 -> 코드상 (+X, +Y) 설정  => 실제 동작: 왼쪽 위(좌상향)
  // state 3: 4번째 변 -> 코드상 (-X, +Y) 설정  => 실제 동작: 오른쪽 위(우상향)
  // state 4: 5번째 변 -> 코드상 (+X, +Y) 설정  => 실제 동작: 왼쪽 위(좌상향)
  // state 5: 6번째 변 -> 코드상 (-X, +Y) 설정  => 실제 동작: 오른쪽 위(우상향) -> 도달 (총 전진 3m)
  
  switch (trajectory_state)
  {
  case 0: // 1번째 변: 코드상 +X (실제 왼쪽 위 출발)
  case 2: // 3번째 변
  case 4: // 5번째 변
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state++;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = +0.8660254f * v;   // +X 방향 = 실제 공간상 왼쪽(+sin 60°)
    vy_world = +0.5f * v;         // +Y 방향 = 실제 공간상 위쪽(+cos 60°)
    
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  case 1: // 2번째 변: 코드상 -X (실제 오른쪽 위)
  case 3: // 4번째 변
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state++;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = -0.8660254f * v;   // -X 방향 = 실제 공간상 오른쪽(-sin 60°)
    vy_world = +0.5f * v;         // +Y 방향 = 실제 공간상 위쪽(+cos 60°)
    
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;

  case 5: // 6번째 변: 코드상 -X (실제 오른쪽 위 - 마지막 변)
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      do_force_after_hold = 1;    // 3m 이동 완료 후 정지
      trajectory_state = 0;
      SoftStop_All();
      return;
    }
    
    v = v_traj;
    vx_world = -0.8660254f * v;   // -X 방향 = 실제 공간상 오른쪽(-sin 60°)
    vy_world = +0.5f * v;         // +Y 방향 = 실제 공간상 위쪽(+cos 60°)
    
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  default:
    trajectory_state = 0;
    s_ref = 0.0f;
    break;
  }
  
  // ====== world -> body 변환 (yaw 기준) ======
  W_b = 0.0f;
  float current_yaw_rad = yaw * (pi / 180.0f);
  
  Vx_traj_b =  vx_world * cosf(current_yaw_rad) + vy_world * sinf(current_yaw_rad);
  Vy_traj_b = -vx_world * sinf(current_yaw_rad) + vy_world * cosf(current_yaw_rad);
}


