void position_function(void)
{
  uint8_t stationary = IsTrulyStationary();
  if (stationary)
  {
    vel_x_cf = 0.0f;
    if (!was_stationary_x)
    {
      pos_x_hold = pos_x;
      was_stationary_x = 1;
    }
    
    pos_x = pos_x_hold;
  }
  else
  {
    was_stationary_x = 0;
    pos_x += vel_x_cf * dt_pos;
  }
  
  if (stationary)
  {
    vel_y_cf = 0.0f;
    
    if (!was_stationary_y)
    {
      pos_y_hold = pos_y;
      was_stationary_y = 1;
    }
    
    pos_y = pos_y_hold;
  }
  else
  {
    was_stationary_y = 0;
    pos_y += vel_y_cf * dt_pos;
  }
}

void angle_function()
{
  yaw_error = yaw_ref - yaw;
  if(yaw_error < -180)
  {
    yaw_error = yaw_error + 360.0;
  }
  else if(yaw_error > 180)
  {
    yaw_error = yaw_error - 360.0;
  }
  
  yaw_error_sum += yaw_error * 0.025;
  yaw_control = yaw_error * yaw_kp - yaw_V * yaw_kd;
}

void Mecanum_wheel_Dynamics_add_DOB()
{
  Omega1 = (1/r)*(Vy_b - Vx_b -(a+b)*W_b);
  Omega2 = (1/r)*(Vy_b + Vx_b -(a+b)*W_b);
  Omega3 = (1/r)*(Vy_b + Vx_b +(a+b)*W_b);
  Omega4 = (1/r)*(Vy_b - Vx_b +(a+b)*W_b);
  
  target1 = Omega1+yaw_control;
  target2 = Omega2+yaw_control;
  target3 = Omega3-yaw_control;
  target4 = Omega4-yaw_control;
  
  Vy_target = Vx_b/14.0;
  Vx_target = Vy_b/14.0;
  
  Sx_ref += Vx_target * 0.05; 
  Sy_ref += Vy_target * 0.05;
}

void Mecanum_wheel_Dynamics_non_DOB()
{
  Omega1 = (1/r)*(Vy_traj_b - Vx_traj_b -(a+b)*W_b);
  Omega2 = (1/r)*(Vy_traj_b + Vx_traj_b -(a+b)*W_b);
  Omega3 = (1/r)*(Vy_traj_b + Vx_traj_b +(a+b)*W_b);
  Omega4 = (1/r)*(Vy_traj_b - Vx_traj_b +(a+b)*W_b);
  
  target1 = Omega1+yaw_control;
  target2 = Omega2+yaw_control;
  target3 = Omega3-yaw_control;
  target4 = Omega4-yaw_control;
  
  Vx_target = Vx_traj_b/14.0;
  Vy_target = Vy_traj_b/14.0;
  
  Sx_ref += Vx_target * 0.05; 
  Sy_ref += Vy_target * 0.05;
}

static inline void RotateCopy9(uint8_t *dst, const uint8_t *src, int start)
{
  for(int k = 0; k < LIDAR_FRAME_LEN; k++)
  {
    dst[k] = src[(start + k) % LIDAR_FRAME_LEN];
  }
}

static inline uint16_t SpikeCut_u16(uint16_t prev, uint16_t curr, uint16_t th)
{
  int diff = (int)curr - (int)prev;
  if (diff < 0) diff = -diff;
  
  if (diff >= th)
    return prev;
  else
    return curr;
}

void LIDER_function(void)
{
  HAL_UART_Receive_DMA(&huart3, Lider_rx_data_y, LIDAR_FRAME_LEN); // y axis
  HAL_UART_Receive_DMA(&huart4, Lider_rx_data_x, LIDAR_FRAME_LEN); // x axis
  
  for(int i = 0; i < LIDAR_FRAME_LEN; i++)
  {
    if(Lider_rx_data_x[i] == LIDAR_HDR0 && Lider_rx_data_x[(i+1) % LIDAR_FRAME_LEN] == LIDAR_HDR1)
    {
      RotateCopy9(Lider_rx_data_xCpy, Lider_rx_data_x, i); // i가 헤더 시작
      break;
    }
  }
  if(Lider_rx_data_xCpy[0] == LIDAR_HDR0 && Lider_rx_data_xCpy[1] == LIDAR_HDR1)
  {
    Dist_x     = (Lider_rx_data_xCpy[2]) | (Lider_rx_data_xCpy[3] << 8);
    strength_x = (Lider_rx_data_xCpy[4]) | (Lider_rx_data_xCpy[5] << 8);
    Temp_x     = (Lider_rx_data_xCpy[6]) | (Lider_rx_data_xCpy[7] << 8);
    check_x    =  Lider_rx_data_xCpy[8];
  }
  for(int j = 0; j < LIDAR_FRAME_LEN; j++)
  {
    if(Lider_rx_data_y[j] == LIDAR_HDR0 && Lider_rx_data_y[(j+1) % LIDAR_FRAME_LEN] == LIDAR_HDR1)
    {
      RotateCopy9(Lider_rx_data_yCpy, Lider_rx_data_y, j);
      break;
    }
  }
  if(Lider_rx_data_yCpy[0] == LIDAR_HDR0 && Lider_rx_data_yCpy[1] == LIDAR_HDR1)
  {
    Dist_y     = (Lider_rx_data_yCpy[2]) | (Lider_rx_data_yCpy[3] << 8);
    strength_y = (Lider_rx_data_yCpy[4]) | (Lider_rx_data_yCpy[5] << 8);
    Temp_y     = (Lider_rx_data_yCpy[6]) | (Lider_rx_data_yCpy[7] << 8);
    check_y    =  Lider_rx_data_yCpy[8];
  }
  
  if (!dist_init)
  {
    Dist_x_prev = Dist_x;
    Dist_y_prev = Dist_y;
    dist_init = 1;
  }
  else
  {
    Dist_x = SpikeCut_u16(Dist_x_prev, Dist_x, 500);
    Dist_y = SpikeCut_u16(Dist_y_prev, Dist_y, 500);
    
    Dist_x_prev = Dist_x;
    Dist_y_prev = Dist_y;
  }
  
  Lider_x_axis  = (Dist_x - 30.0f) * 0.01f;
  Lider_y_axis = (200.0f - Dist_y) * 0.01f;
}


