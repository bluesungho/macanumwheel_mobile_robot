void EBIMU9_DOFV5_function()
{
  HAL_UART_Receive_DMA(&huart1,gyro_buffer, GYRO_BUFFER_SIZE);
  
  for(int i = 0; i < GYRO_BUFFER_SIZE-1; i++)
  {
    if(gyro_buffer[i] == 0x55 && gyro_buffer[i+1] == 0x55)
    {
      
      for(int j = 0 ; j < i ; j++)
      {
        gyro_bufferCpy[j+(22-i)] = gyro_buffer[j];
      }
      
      for(int k = 0 ; k < 22 - i ; k++)
      {
        gyro_bufferCpy[k] = gyro_buffer[i+k];
      }
    }
  }
  
  if(gyro_bufferCpy[0] == 0x55 && gyro_bufferCpy[1] == 0x55)
    
  {
    Euler_Roll = (gyro_bufferCpy[2] << 8) | gyro_bufferCpy[3];
    Euler_Pitch = (gyro_bufferCpy[4] << 8) | gyro_bufferCpy[5];
    Euler_Yaw = (gyro_bufferCpy[6] << 8) | gyro_bufferCpy[7];
    
    
    roll = Euler_Roll / 100.0;
    pitch = Euler_Pitch / 100.0;
    yaw_raw_deg = Euler_Yaw / 100.0;
    
    if (!yaw_offset_set) {
      yaw_offset = yaw_raw_deg;
      yaw_offset_set = 1;
    }
    yaw = yaw_raw_deg - yaw_offset;  
    
    Euler_Roll_V = (gyro_bufferCpy[8] << 8) | gyro_bufferCpy[9];
    Euler_Pitch_V = (gyro_bufferCpy[10] << 8) | gyro_bufferCpy[11];
    Euler_Yaw_V = (gyro_bufferCpy[12] << 8) | gyro_bufferCpy[13];
    
    roll_V = Euler_Roll_V/ 10.0;
    pitch_V = Euler_Pitch_V / 10.0;
    yaw_V = Euler_Yaw_V / 10.0;
    
    Euler_X_aixs_A = (gyro_bufferCpy[14] << 8 | gyro_bufferCpy[15]);
    Euler_Y_aixs_A = (gyro_bufferCpy[16] << 8 | gyro_bufferCpy[17]);
    Euler_Z_aixs_A = (gyro_bufferCpy[18] << 8 | gyro_bufferCpy[19]);
    
    X_aixs_A = Euler_X_aixs_A / 1000.0 * G;
    Y_aixs_A = Euler_Y_aixs_A / 1000.0 * G;
    Z_aixs_A = Euler_Z_aixs_A / 1000.0 * G;
    
    
  }
  else
  {
    //HAL_UART_Init(&huart2);
    //flag = 2;
  }
}


static inline void Acc_BodyToWorld_deg(float ax, float ay, float az,float roll_deg, float pitch_deg, float yaw_deg,volatile float *ax_w, volatile float *ay_w, volatile float *az_w)
{
  float r = roll_deg  * DEG2RAD;
  float p = pitch_deg * DEG2RAD;
  float y = yaw_deg   * DEG2RAD;
  
  float cr = cosf(r), sr = sinf(r);
  float cp = cosf(p), sp = sinf(p);
  float cy = cosf(y), sy = sinf(y);
  
  *ax_w = (cy*cp)*ax + (cy*sp*sr - sy*cr)*ay + (cy*sp*cr + sy*sr)*az;
  *ay_w = (sy*cp)*ax + (sy*sp*sr + cy*cr)*ay + (sy*sp*cr - cy*sr)*az;
  *az_w = (-sp)*ax + (cp*sr)*ay + (cp*cr)*az;
}


static inline float Acc_MA_Update_X(float new_acc_x)
{
  acc_wX_ma_sum -= acc_wX_ma_buf[acc_wX_ma_idx];
  acc_wX_ma_buf[acc_wX_ma_idx] = new_acc_x;
  acc_wX_ma_sum += new_acc_x;
  acc_wX_ma_idx++;
  if (acc_wX_ma_idx >= ACC_MA_SIZE)
    acc_wX_ma_idx = 0;
  
  return acc_wX_ma_sum / (float)ACC_MA_SIZE;
}


static inline float Acc_MA_Update_Y(float new_acc_y)
{
  acc_wY_ma_sum -= acc_wY_ma_buf[acc_wY_ma_idx];
  acc_wY_ma_buf[acc_wY_ma_idx] = new_acc_y;
  acc_wY_ma_sum += new_acc_y;
  acc_wY_ma_idx++;
  if (acc_wY_ma_idx >= ACC_MA_SIZE)
    acc_wY_ma_idx = 0;
  
  return acc_wY_ma_sum / (float)ACC_MA_SIZE;
}


static inline float Acc_LPF_Update_X(float acc_x_ma)
{
  float acc_x_lpf;
  acc_x_lpf = (acc_x_ma * dt_lpf + Tau_lpf * acc_wX_lpf_prev) / (Tau_lpf + dt_lpf);
  acc_wX_lpf_prev = acc_x_lpf;
  
  return acc_x_lpf;
}


static inline float Acc_LPF_Update_Y(float acc_y_ma)
{
  float acc_y_lpf;
  acc_y_lpf = (acc_y_ma * dt_lpf + Tau_lpf * acc_wY_lpf_prev) / (Tau_lpf + dt_lpf);
  acc_wY_lpf_prev = acc_y_lpf;
  
  return acc_y_lpf;
}


void LPF()
{
  Acc_BodyToWorld_deg(X_aixs_A, Y_aixs_A, Z_aixs_A, roll, pitch, yaw, &acc_wX, &acc_wY, &acc_wZ);
  acc_wX_ma = Acc_MA_Update_X(acc_wX);
  acc_wY_ma = Acc_MA_Update_Y(acc_wY);
  
  acc_wX_lpf = Acc_LPF_Update_X(acc_wX_ma);
  acc_wY_lpf = Acc_LPF_Update_Y(acc_wY_ma);
}


static inline float fabsf_fast(float x)
{
  return (x >= 0.0f) ? x : -x;
}


static inline uint8_t IsTrulyStationary(void)
{
  const float GYRO_THR = 2.0f;    // deg/s
  const float VENC_THR = 0.03f;   // m/s
  const float VREF_THR = 0.01f;   // m/s
  
  float gyro_sum = fabsf_fast(roll_V) + fabsf_fast(pitch_V) + fabsf_fast(yaw_V);
  if (gyro_sum > GYRO_THR) return 0;
  
  if (fabsf_fast(Vx_enc) > VENC_THR) return 0;
  if (fabsf_fast(Vy_enc) > VENC_THR) return 0;
  
  // 명령도 0일 때만 "정지"
  if (fabsf_fast(Vx_traj_b) > VREF_THR) return 0;
  if (fabsf_fast(Vy_traj_b) > VREF_THR) return 0;
  
  return 1;
}

void Velocity_ZUPT_Update(void)
{
  static int st_cnt = 0;
  const int ST_N = 50;
  
  if (IsTrulyStationary()) st_cnt++;
