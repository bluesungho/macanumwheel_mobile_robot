static inline float clampf2(float x, float lo, float hi)
{
  if (x < lo) return lo;
  if (x > hi) return hi;
  return x;
}

void SlipCF_Update(void)
{
  // 1) IMU-only velocity prediction (참조용)
  vimu_x += acc_wX_lpf * dt_slip;
  vimu_y += acc_wY_lpf * dt_slip;
  
  // 2) abs values
  float ax = acc_wX_lpf;
  float ay = acc_wY_lpf;
  
  float aabs_x = (ax >= 0.0f) ? ax : -ax;
  float aabs_y = (ay >= 0.0f) ? ay : -ay;
  
  float venc_x = Vx_enc;
  float venc_y = Vy_enc;
  
  float abs_venc_x = (venc_x >= 0.0f) ? venc_x : -venc_x;
  float abs_venc_y = (venc_y >= 0.0f) ? venc_y : -venc_y;
  
  // 3) lambda adaptation gain
  //    k_lambda_base: 너무 크면 lambda 튐 / 너무 작으면 적응 느림
  const float k_lambda_base = 0.008f;
  
  float kx = (aabs_x > AIMU_MIN) ? k_lambda_base : (0.2f * k_lambda_base);
  float ky = (aabs_y > AIMU_MIN) ? k_lambda_base : (0.2f * k_lambda_base);
  
  // 4) Update lambda_x
  if (abs_venc_x > VENC_MIN)
  {
    float ex = vimu_x - lambda_x * venc_x;   // e = vimu - lambda*venc
    lambda_x += kx * ex * venc_x;            // gradient step
    lambda_x = clampf2(lambda_x, LAM_MIN_X, LAM_MAX_X);
  }
  
  // 5) Update lambda_y
  
  if (abs_venc_y > VENC_MIN)
  {
    float ey = vimu_y - lambda_y * venc_y;
    lambda_y += ky * ey * venc_y;
    lambda_y = clampf2(lambda_y, LAM_MIN_Y, LAM_MAX_Y);
  }
  
  // 6) Correct encoder velocity
  float vx_enc_corr = lambda_x * Vx_enc;
  float vy_enc_corr = lambda_y * Vy_enc;
  
  // 7) Complementary fusion
  float alpha_x = tau_cf_base_x / (tau_cf_base_x + dt_slip);
  float alpha_y = tau_cf_base_y / (tau_cf_base_y + dt_slip);
  
  float vx_imu_pred = vel_x_cf + acc_wX_lpf * dt_slip;
  float vy_imu_pred = vel_y_cf + acc_wY_lpf * dt_slip;
  
  vel_x_cf = alpha_x * vx_imu_pred + (1.0f - alpha_x) * vx_enc_corr;
  vel_y_cf = alpha_y * vy_imu_pred + (1.0f - alpha_y) * vy_enc_corr;
  
  // 8) (선택) vimu 동기화(폭주 방지)
  const float sync = 0.02f; // 0~0.05
  vimu_x = (1.0f - sync) * vimu_x + sync * vel_x_cf;
  vimu_y = (1.0f - sync) * vimu_y + sync * vel_y_cf;
}

