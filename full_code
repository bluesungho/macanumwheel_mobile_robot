void Encoder_function()
{
  Encoder1 = TIM1->CNT;
  Encoder2 = TIM2->CNT;
  Encoder3 = TIM5->CNT;
  Encoder4 = TIM8->CNT;
  
  //Encoder NO.1
  if(Encoder1 - pre_Encoder1 < -60000)
    Linear_cnt1 ++;
  
  else if(Encoder1 - pre_Encoder1 > 60000)
    Linear_cnt1 --;
  
  Linear_Encoder_cnt1 = Encoder1 + Linear_cnt1 * 65000;
  
  Vel_Cur1 = (Linear_Encoder_cnt1 - pre_Linear_Encoder_cnt1) * 0.15707;
  
  Vel_omega1 = Vel_Cur1 / 14.0;
  
  accel1 = (Vel_Cur1 - pre_Vel_Cur1)/0.01;
  
  pre_Encoder1 = Encoder1;
  
  pre_Linear_Encoder_cnt1 = Linear_Encoder_cnt1;
  
  pre_Vel_Cur1 = Vel_Cur1;
  
  
