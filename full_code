    }
  }
  
  /* Motor NO.4 --------------------------------------------------------------*/
  Vel_Error4 = target4 - Vel_Cur4;
  Vel_Error_Sum4 += Vel_Error4 * 0.01;
  u_tilda4 = Vel_Kp * Vel_Error4 + Vel_Ki * Vel_Error_Sum4;
  
  DOB_Error4 = J * accel4 + B * Vel_Cur4 - Vel_Control4*kt;
