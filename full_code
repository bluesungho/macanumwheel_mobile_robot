void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
  if(htim == &htim3)
  {
    // ====== Reset_Flag가 1에서 0으로 떨어지는 순간 시스템 하드웨어 리셋 ======
    if (pre_Reset_Flag == 1 && Reset_Flag == 0)
    {
      // 모터 구동 중 리셋 시 순간 튐 방지를 위해 안전하게 PWM만 꺼주고 리셋
      TIM3->CCR1 = 0; TIM3->CCR2 = 0; TIM3->CCR3 = 0; TIM3->CCR4 = 0;
      
      NVIC_SystemReset(); // 이 코드가 실행되면 아래 코드는 실행되지 않고 칩이 재부팅됩니다.
    }
    pre_Reset_Flag = Reset_Flag;
    
    cnt++;
    
    TIM3 -> CCR1 = Motor_CCR1;
    TIM3 -> CCR2 = Motor_CCR2;
    TIM3 -> CCR3 = Motor_CCR3;
    TIM3 -> CCR4 = Motor_CCR4;
    
    Brk_reset();
    
    if(cnt % 20 == 0)
    {
      Current_LPF_function();
      Current_control_function();
    }
    
    if(cnt % 200 == 0)
    {
      Encoder_function();
      Velocity_control_function();
      EBIMU9_DOFV5_function();
      LIDER_function();
    }
    
    if(cnt % 500 == 0)
    {
      LPF();
      X_Y_aixs();
      SlipCF_Update();
      Velocity_ZUPT_Update();
      angle_function();
      
      lumped_disturbance();
    }
    
    if(cnt % 1000 == 0)
    {
      position_function();

      
      Trajectory_squre_function();
      //Trajectory_triangle_function();
      //Trajectory_eight_circle_function();
   
      //Trajectory_parallelogram_function();
      //Trajectory_zigzag_function();
      //Trajectory_star_function();
      
      //Trajectory_maca_square_function();
      
      Mecanum_wheel_body_DOB();
      
      
      //non_DOB & add_DOB
      Mecanum_wheel_Dynamics_add_DOB();
      //Mecanum_wheel_Dynamics_non_DOB();
      
      
      jetson_orin_tx();
      jetson_orin_rx();
      
      cnt = 0;   
    }
  }
}

float apply_moving_average(float new_sample, float* buffer, float* current_sum, int* index)
{
  *current_sum -= buffer[*index];
  buffer[*index] = new_sample;
  *current_sum += new_sample;
  
  (*index)++;
  if (*index >= CB_SIZE)
    *index = 0;
  
  return (*current_sum) / CB_SIZE;
}

void Current_LPF_function()
{
  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)ADC_buffer, sizeof(ADC_buffer));
  
  Volt1 = (ADC_buffer[0] * 3.3) / 1023.0;
  Current1 = ((Volt1 - 1.65) * Current_Scale) + Current_Offset1;
  if (Current1 < 0)
    Current1 = 0;
  
  Volt2 = (ADC_buffer[1] * 3.3) / 1023.0;
  Current2 = ((Volt2 - 1.65) * Current_Scale) + Current_Offset2;
  if (Current2 < 0)
    Current2 = 0;
  
  Volt3 = (ADC_buffer[2] * 3.3) / 1023.0;
  Current3 = ((Volt3 - 1.65) * Current_Scale) + Current_Offset3;
  if (Current3 < 0)
    Current3 = 0;
  
  Volt4 = (ADC_buffer[3] * 3.3) / 1023.0;
  Current4 = ((Volt4 - 1.65) * Current_Scale) + Current_Offset4;
  if (Current4 < 0)
    Current4 = 0;
  
  Current_lpf1 = (Current1 * dt_current + Tau_current * pre_Current_lpf1) / (Tau_current + dt_current);
  Current_ma1 = apply_moving_average(Current_lpf1, current_buffer1, &current_sum1, &buffer_index1);
  
  Current_lpf2 = (Current2 * dt_current + Tau_current * pre_Current_lpf2) / (Tau_current + dt_current);
  Current_ma2 = apply_moving_average(Current_lpf2, current_buffer2, &current_sum2, &buffer_index2);
  
  Current_lpf3 = (Current3 * dt_current + Tau_current * pre_Current_lpf3) / (Tau_current + dt_current);
  Current_ma3 = apply_moving_average(Current_lpf3, current_buffer3, &current_sum3, &buffer_index3);
  
  Current_lpf4 = (Current4 * dt_current + Tau_current * pre_Current_lpf4) / (Tau_current + dt_current);
  Current_ma4 = apply_moving_average(Current_lpf4, current_buffer4, &current_sum4, &buffer_index4);
  
  pre_Current_lpf1 = Current_lpf1;
  pre_Current_lpf2 = Current_lpf2;
  pre_Current_lpf3 = Current_lpf3;
  pre_Current_lpf4 = Current_lpf4;
  
  HAL_ADC_Stop_DMA(&hadc1);
}

void Current_control_function()
{
  /* Motor NO.1 --------------------------------------------------------------*/
  if(target1 * pre_target1 < 0)
  {
    Current_Error1 = 0;
    Current_Error_Sum1 = 0;
    Vel_Error1 = 0;
    Vel_Error_Sum1 = 0;
  }
  
  if(Vel_Control1 >= 0.0)
  {
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, 1);
    dir1 = 1;
    Current_Error1 = Vel_Control1 - Current_ma1;
  }
  else if(Vel_Control1 < 0.0)
  {
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, 0);
    dir1 = -1;
    Current_Error1= -Vel_Control1 - Current_ma1;
  }
  
  Current_Error_Sum1 += Current_Error1 * 0.001;
  Current_Control1 = Current_Kp * Current_Error1 + Current_Ki * Current_Error_Sum1 + 0.12 * Vel_Cur1;
  
  if(Current_Control1 >= 0)
  {
    if(Current_Control1 > Current_limit)
    {
      Current_Error_Sum1 -= (Current_Control1 - Current_limit) * 1 / Current_Kp / 3;
      Current_Control1 = Current_limit;
    }
    Motor_CCR1 = Current_Control1;
  }
  else if(Current_Control1 < 0)
  {
    Current_Control1 = 0;
    Motor_CCR1 = 0;
  }
  
  
  /* Motor NO.2 --------------------------------------------------------------*/
