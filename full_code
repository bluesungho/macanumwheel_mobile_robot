void Trajectory_maca_square_function(void)
{
  static int trajectory_state = 0;
  static uint8_t corner_hold = 0;
  static int hold_cnt = 0;
  static uint8_t do_force_after_hold = 0;
  
  const float L_traj = 1.5f;   // 사각형 한 변 길이 [m]
  const float dt_ref = 0.05f;
  
  // 브레이크 비상 정지 상태 확인
  if (Brk == 1)
  {
    ForceStop_All();
    vel_x_model = 0.0f;
    vel_y_model = 0.0f;
    trajectory_state = 0;
    corner_hold = 0;
    hold_cnt = 0;
    do_force_after_hold = 0;
    s_ref = 0.0f;
    return;
  }
  
  // ====== 코너 대기(Hold) 구간 ======
  if (corner_hold)
  {
    SoftStop_All();
    
    if (++hold_cnt >= CORNER_HOLD_N)
    {
      corner_hold = 0;
      hold_cnt = 0;
      s_ref = 0.0f;
      
      if (do_force_after_hold)
      {
        ForceStop_All();
        Brk = 1; // 최종 보정 주행까지 모두 완료된 후 모터 정지 (Brk = 1)
        do_force_after_hold = 0;
        return;
      }
    }
    return;
  }
  
  // ====== 시퀀스 상태 머신 ======
  switch (trajectory_state)
  {
  // --- 1단계: 네모(사각형) 주행 ---
  case 0: // +Y 방향 이동
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 1;
      SoftStop_All();
      return;
    }
    v = v_traj;
    vx_world = 0.0f;
    vy_world = +v;
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  case 1: // +X 방향 이동
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 2;
      SoftStop_All();
      return;
    }
    v = v_traj;
    vx_world = +v;
    vy_world = 0.0f;
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  case 2: // -Y 방향 이동
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 3;
      SoftStop_All();
      return;
    }
    v = v_traj;
    vx_world = 0.0f;
    vy_world = -v;
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  case 3: // -X 방향 이동 (네모 주행 완료)
    if (s_ref >= L_traj)
    {
      corner_hold = 1;
      hold_cnt = 0;
      trajectory_state = 4; // 네모 완주 후 Jetson 보정량 대기 단계로 전이
      SoftStop_All();
      return;
    }
    v = v_traj;
    vx_world = -v;
    vy_world = 0.0f;
    s_ref += fabsf(v) * dt_ref / 14.0f;
    break;
    
  // --- 2단계: 네모 완주 후 정지 상태에서 Jetson cVAE/Kinematics 보정 오프셋 수신 대기 ---
  case 4:
    SoftStop_All(); // Brk=0인 상태로 정지하여 속도를 0으로 유지 (Jetson이 1.5초 정지를 감지)
    
    // Jetson으로부터 유효한 보정 오프셋(Manipulator_Target_X, Y)이 수신되면 보정 주행 단계(State 5)로 진입
    if (fabsf(Manipulator_Target_X) > 0.0001f || fabsf(Manipulator_Target_Y) > 0.0001f)
    {
      s_ref = 0.0f;
      trajectory_state = 5;
    }
    return;
  // --- 3단계: cVAE/Kinematics 보정량(Manipulator_Target_X, Y)만큼 target 속도(v_traj)로 추가 이동 ---
  case 5:
    {
      float dx_comp = Manipulator_Target_X;
      float dy_comp = Manipulator_Target_Y;
      float comp_dist = sqrtf(dx_comp * dx_comp + dy_comp * dy_comp);
      
      // 보정 이동 완료 확인
      if (comp_dist <= 0.001f || s_ref >= comp_dist)
      {
        corner_hold = 1;
        hold_cnt = 0;
        do_force_after_hold = 1; // 보정 주행까지 완벽히 끝났으므로 최종 정지 (Brk = 1)
        trajectory_state = 0;
        SoftStop_All();
        return;
      }
      
      // 보정 오프셋 방향 단위 벡터 계산 및 world 속도 생성
      v = v_traj;
      vx_world = v * (dx_comp / comp_dist);
      vy_world = v * (dy_comp / comp_dist);
      s_ref += fabsf(v) * dt_ref / 14.0f;
    }
    break;
  default:
    trajectory_state = 0;
    s_ref = 0.0f;
    break;
  }
  
  // ====== world -> body 변환 (yaw 기준) ======
  W_b = 0.0f;
  float current_yaw_rad = yaw * (pi / 180.0f);
  
  Vx_traj_b =  vx_world * cosf(current_yaw_rad) + vy_world * sinf(current_yaw_rad);
  Vy_traj_b = -vx_world * sinf(current_yaw_rad) + vy_world * cosf(current_yaw_rad);
}






typedef struct {
  float b0, b1, b2;
  float a1, a2;      // denominator: 1 + a1 z^-1 + a2 z^-2
  float x1, x2;      // x[n-1], x[n-2]
  float y1, y2;      // y[n-1], y[n-2]
} Biquad2_t;

static inline void Biquad_Reset(Biquad2_t *f)
{
  f->x1 = f->x2 = 0.0f;
  f->y1 = f->y2 = 0.0f;
}

static inline float Biquad_Step(Biquad2_t *f, float x)
{
  float y = f->b0*x + f->b1*f->x1 + f->b2*f->x2
    - f->a1*f->y1 - f->a2*f->y2;
  
  f->x2 = f->x1;  f->x1 = x;
  f->y2 = f->y1;  f->y1 = y;
  return y;
}

// Tustin(bilinear) : continuous (b2 s^2 + b1 s + b0)/(a2 s^2 + a1 s + a0) -> biquad
static inline void Biquad_FromContinuous_Tustin(
                                                Biquad2_t *f,
                                                float b2, float b1, float b0,
                                                float a2, float a1, float a0,
                                                float T)
{
  // Numerator (q=z^-1) : N2 q^2 + N1 q + N0
  float N2 = (T*T)*b0 - 2.0f*T*b1 + 4.0f*b2;
  float N1 = 2.0f*(T*T)*b0 - 8.0f*b2;
  float N0 = (T*T)*b0 + 2.0f*T*b1 + 4.0f*b2;
  
  // Denominator (q=z^-1) : D2 q^2 + D1 q + D0
  float D2 = (T*T)*a0 - 2.0f*T*a1 + 4.0f*a2;
  float D1 = 2.0f*(T*T)*a0 - 8.0f*a2;
  float D0 = (T*T)*a0 + 2.0f*T*a1 + 4.0f*a2;
  
  // normalize by D0 -> (B0 + B1 q + B2 q^2)/(1 + A1 q + A2 q^2)
  float invD0 = 1.0f / D0;
  
  f->b0 = N0 * invD0;
  f->b1 = N1 * invD0;
  f->b2 = N2 * invD0;
  
  f->a1 = D1 * invD0;
  f->a2 = D2 * invD0;
  
  Biquad_Reset(f);
}


void Make_Q_2nd(Biquad2_t *Q, float wc, float zc, float T)
{
  float b2 = 0.0f, b1 = 0.0f, b0 = wc*wc;
  float a2 = 1.0f, a1 = 2.0f*zc*wc, a0 = wc*wc;
  
  Biquad_FromContinuous_Tustin(Q, b2,b1,b0, a2,a1,a0, T);
}


void Make_F_2nd(Biquad2_t *F, float wc, float zc, float wn, float zn, float T)
{
  float k = (wc*wc) / (wn*wn);
  
  float b2 = k;
  float b1 = k * 2.0f*zn*wn;
  float b0 = wc*wc;
  
  float a2 = 1.0f;
  float a1 = 2.0f*zc*wc;
  float a0 = wc*wc;
  
  Biquad_FromContinuous_Tustin(F, b2,b1,b0, a2,a1,a0, T);
}

Biquad2_t Qx, Qy;
Biquad2_t Fx, Fy;


void Mecanum_wheel_body_DOB()
{
  float qx = Biquad_Step(&Qx, pre_Vx_b);
  float fx = Biquad_Step(&Fx, vel_x_cf);
  d_hat_x = -qx + fx*14.0;
  Vx_b = Vx_traj_b - kdob * d_hat_x;
  
  float qy = Biquad_Step(&Qy, pre_Vy_b);
  float fy = Biquad_Step(&Fy, vel_y_cf);
  d_hat_y = -qy + fy*14.0;
  Vy_b = Vy_traj_b - kdob * d_hat_y;
  
  Vx_b_veiw = Vx_b/14.0;
  Vy_b_veiw = Vy_b/14.0;
  d_hat_x_veiw = d_hat_x/14.0;
  d_hat_y_veiw = d_hat_y/14.0;
  
  pre_Vx_b = Vx_b; 
  pre_Vy_b = Vy_b;
}

static inline float sgn_dead(float v, float eps)
{
  if (v >  eps) return  1.0f;
  if (v < -eps) return -1.0f;
  return 0.0f;
}

void lumped_disturbance()
{
  vel_ref_x = Vx_traj_b / 14.0f;
  vel_ref_y = Vy_traj_b / 14.0f;
  
  dis_F1 = Current_ma1 * dir1;
  dis_F2 = Current_ma2 * dir2;
  dis_F3 = Current_ma3 * dir3;
  dis_F4 = Current_ma4 * dir4;
  
  dis_x_exp = vel_ref_x - vel_x_cf;
  dis_y_exp = vel_ref_y - vel_y_cf;
  
  Current_sum_x = 0.707f * (-dis_F1 +dis_F2 + dis_F3 - dis_F4);
  Current_sum_y = 0.707f * (dis_F1 +dis_F2 + dis_F3 + dis_F4);
  
  float Ieff_x = Current_sum_x;
  float Ieff_y = Current_sum_y;
  
  sgnx = sgn_dead(vel_x_model, 0.02f); 
  sgny = sgn_dead(vel_y_model, 0.02f);
  
  resist_x = (dis_mu_x * dis_m * dis_g) * sgnx + (dis_c_x * vel_x_model);
  resist_y = (dis_mu_y * dis_m * dis_g) * sgny + (dis_c_y * vel_y_model);
  
  
  if (fabsf(Ieff_x) < 0.2f) Ieff_x = 0.0f;
  if (fabsf(Ieff_y) < 0.2f) Ieff_y = 0.0f;
  
  F_net = 0.7149f * dis_K * Ieff_y - ((dis_mu_y * dis_m * dis_g) * sgny + dis_c_y * vel_y_model);
  
  vel_x_model += dis_Ts * (0.6227f * dis_K * Ieff_x - resist_x)/dis_m ;
  vel_y_model += dis_Ts * (0.7149f * dis_K * Ieff_y - resist_y)/dis_m;
  
  dis_x_for = vel_ref_x - vel_x_model;
  dis_y_for = vel_ref_y - vel_y_model;
  
  
  vel_x_cf_dot = (vel_x_cf - pre_vel_x_cf)/dis_Ts;
  vel_y_cf_dot = (vel_y_cf - pre_vel_y_cf)/dis_Ts;
  
  
  dis_x_alpha = (dis_m * vel_x_cf_dot + dis_mu_x * dis_m * dis_g + dis_c_x * vel_x_cf)/(dis_K*Current_sum_x);
  dis_y_alpha = (dis_m * vel_y_cf_dot + dis_mu_y * dis_m * dis_g + dis_c_y * vel_y_cf)/(dis_K*Current_sum_y);
  
  pre_vel_x_cf = vel_x_cf;
  pre_vel_y_cf = vel_y_cf;
}


